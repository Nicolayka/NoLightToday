# Получить токен: https://t.me/BotFather
BOT_TOKEN=123456789:AA...ваш_токен

# Свой ID: https://t.me/userinfobot
# Несколько — через запятую: 111111,222222
ADMIN_IDS=123456789

# Период проверки сайта, сек (3600 = 1 час)
CHECK_INTERVAL=3600

# Прокси для Telegram. Оставьте пустым, если сервер вне РФ
# и api.telegram.org доступен напрямую.
# На RU VPS провайдеры блокируют api.telegram.org по SNI,
# поэтому нужен SOCKS5 или HTTP-прокси вне России.
#
# Формат:
#   socks5://user:password@host:port
#   http://user:password@host:port
#
# Пример:
# TELEGRAM_PROXY=socks5://user:pass@host:port
TELEGRAM_PROXY=